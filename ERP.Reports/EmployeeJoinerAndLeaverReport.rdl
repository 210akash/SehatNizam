    <DataSet Name="StatusList">
      <Query>
        <DataSourceName>ERPDB</DataSourceName>
        <CommandText>SELECT NULL As Id, 'ALL' AS Name
UNION ALL
SELECT 1 As Id, 'Active' AS Name
UNION ALL
SELECT 0 As Id, 'Not-Active' AS Name
</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
