  <DataSources>
    <DataSource Name="DSKhilafat">
      <DataSourceReference>ERPDB</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>4210a4cb-9b92-401f-8702-c79c0c29162d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@distributor">
            <Value>=Parameters!distributor.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fromDate">
            <Value>=Parameters!fromDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@toDate">
            <Value>=Parameters!toDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@orderStatus">
            <Value>=Parameters!orderStatus.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
DIS.Name DistributorName,OrderId OrderNo, convert(varchar, ord.createdDate, 106) OrderDate, OS.Name OrderStatus, USR.FirstName + ' ' + USR.LastName OrderBy,  
PRD.Name ProductName, PRd.Type ProductType,PRD.VolumeinML, OI.DistributorPrice, OI.Quantity

FROM 
Product PRD
left Join OrderItems OI on PRD.Id = OI.ProductId AND OI.IsActive = 1
Join [Order] ORD on OI.OrderId = ORD.id
join OrderStatus OS on ORD.OrderStatusId = OS.Id
join AspNetUsers USR on ORD.CreatedById = USR.ID
join Dealerships DIS on DIS.Id = ORD.DealershipId
join Territories TER on DIS.TerritoryId = TER.Id
Where 
PRD.IsActive = 1 
AND ORD.ShopId IS  NULL and ORD.DealershipId IS Not NULL
AND ORD.IsActive = 1
AND (@distributor IS NULL OR DIS.Id = @distributor)
AND (@fromDate IS NULL OR CAST(ORD.CreatedDate AS DATE) &gt;= @fromDate)
AND (@toDate IS NULL OR CAST(ORD.CreatedDate AS DATE) &lt;= @toDate)
AND (@orderStatus IS NULL OR ORD.OrderStatusId = @orderStatus)
Order by DIS.ID, Ord.Id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DistributorName">
          <DataField>DistributorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="OrderDate">
          <DataField>OrderDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderStatus">
          <DataField>OrderStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderBy">
          <DataField>OrderBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductType">
          <DataField>ProductType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VolumeinML">
          <DataField>VolumeinML</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DistributorPrice">
          <DataField>DistributorPrice</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSDistributor">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'All' AS Name
UNION
SELECT        Id, Name
FROM            Dealerships
WHERE        (IsActive = 1)</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSStatus">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'All' AS Name
UNION
Select ID,Name from OrderStatus</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
