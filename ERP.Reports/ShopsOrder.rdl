  <DataSources>
    <DataSource Name="DSKhilafat">
      <DataSourceReference>ERPDB</DataSourceReference>
      <rd:SecurityType>DataBase</rd:SecurityType>
      <rd:DataSourceID>64eecd4b-a019-4af7-a236-a67a2a9b9e12</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@distributor">
            <Value>=Parameters!distributor.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@fromDate">
            <Value>=Parameters!fromDate.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@toDate">
            <Value>=Parameters!toDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@orderStatus">
            <Value>=Parameters!orderStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@shops">
            <Value>=Parameters!shops.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
DIS.Name DistributorName,OrderId OrderNo, convert(varchar, ord.createdDate, 106) OrderDate, OS.Name OrderStatus, USR.FirstName + ' ' + USR.LastName OrderBy,  
PRD.Name ProductName, PRd.Type ProductType,PRD.VolumeinML, OI.TradePrice, OI.Quantity, SP.Name ShopName, Sp.Address ShopAddress

FROM 
Product PRD
left Join OrderItems OI on PRD.Id = OI.ProductId AND OI.IsActive = 1
Join [Order] ORD on OI.OrderId = ORD.id
join OrderStatus OS on ORD.OrderStatusId = OS.Id
join AspNetUsers USR on ORD.DSFId = USR.ID
join Shops SP on ORD.ShopId = sp.Id 
join Territories TER on sp.TerritoryId = TER.Id
join Dealerships DIS on DIS.TerritoryId = TER.ID
Where 
PRD.IsActive = 1 AND ORD.IsActive = 1
AND ORD.ShopId IS NOT NULL and ORD.DealershipId IS  NULL
AND (@distributor IS NULL OR DIS.Id = @distributor)
AND (@fromDate IS NULL OR CAST(ORD.CreatedDate AS DATE) &gt;= @fromDate)
AND (@toDate IS NULL OR CAST(ORD.CreatedDate AS DATE) &lt;= @toDate)
AND (@orderStatus IS NULL OR ORD.OrderStatusId = @orderStatus)
AND (@shops IS NULL OR ORD.ShopId = @shops)

Order by DIS.ID,Sp.Id , Ord.Id</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="DistributorName">
          <DataField>DistributorName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderNo">
          <DataField>OrderNo</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="OrderDate">
          <DataField>OrderDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderStatus">
          <DataField>OrderStatus</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OrderBy">
          <DataField>OrderBy</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductName">
          <DataField>ProductName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ProductType">
          <DataField>ProductType</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="VolumeinML">
          <DataField>VolumeinML</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TradePrice">
          <DataField>TradePrice</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Quantity">
          <DataField>Quantity</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ShopName">
          <DataField>ShopName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ShopAddress">
          <DataField>ShopAddress</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSDistributor">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'All' AS Name
UNION
SELECT        Id, Name
FROM            Dealerships
WHERE        (IsActive = 1)</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="OrderStatus">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <CommandText>SELECT        NULL AS Id, 'All' AS Name
UNION
Select ID,Name from OrderStatus</CommandText>
      </Query>
      <Fields>
        <Field Name="ID">
          <DataField>Id</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DSShops">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@distributor">
            <Value>=Parameters!distributor.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT        NULL AS ID, 'All' AS Name
UNION
SELECT 
ID,
Name
from 
Shops SP
where IsActive = 1 AND IsVerified = 1
AND (@distributor IS NULL  OR TerritoryId = (SELECT TerritoryId FROM Dealerships WHERE Id = @distributor)
)</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>ID</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
