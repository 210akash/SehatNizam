    <DataSet Name="DistanceOptions">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@FilterBy">
            <Value>=Parameters!FilterBy.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT CAST(0 AS INT) AS Distance WHERE @FilterBy IS NOT NULL</CommandText>
      </Query>
      <Fields>
        <Field Name="Distance">
          <DataField>Distance</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
