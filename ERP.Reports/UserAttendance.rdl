    <DataSet Name="RolesList">
      <Query>
        <DataSourceName>DSKhilafat</DataSourceName>
        <CommandText>
SELECT        Id, Name
FROM            AspNetRoles
WHERE    (IsActive = 1)</CommandText>
      </Query>
