                          <rd:DefaultName>Textbox11</rd:DefaultName>
                          <ActionInfo>
                            <Actions>
                              <Action>
                                <Hyperlink>=IIf(
    IsNothing(Fields!InLocation.Value) Or Fields!InLocation.Value = "",
    Nothing,
    "javascript:void(window.open('https://www.google.com/maps?q=" &amp; 
    Mid(
        Fields!InLocation.Value, 
        InStr(Fields!InLocation.Value, """lat"":") + 6, 
        InStr(Fields!InLocation.Value, ",") - InStr(Fields!InLocation.Value, """lat"":") - 6
    ) &amp; 
    "," &amp; 
    Replace(
        Mid(
            Fields!InLocation.Value, 
            InStr(Fields!InLocation.Value, """lng"":") + 6, 
            Len(Fields!InLocation.Value)
